  "bugs": {
    "url": "https://github.com/shreyasxgowda/people-crud/issues"
  },
  "homepage": "https://github.com/shreyasxgowda/people-crud#readme",
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
